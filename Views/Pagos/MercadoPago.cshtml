@model demomvcdata.Models.MercadoPagoCheckoutViewModel

@{
    ViewData["Title"] = "Pagar con Mercado Pago";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm mt-4">
            <div class="card-body">
                <h1 class="h4 mb-3">Pagar con Mercado Pago</h1>
                <p class="text-muted">Ingresa el monto y tu DNI para continuar al checkout.</p>

                <form asp-action="MercadoPago" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Monto" class="form-label"></label>
                        <input asp-for="Monto" class="form-control" type="number" min="1" step="0.01" />
                        <span asp-validation-for="Monto" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Dni" class="form-label"></label>
                        <input asp-for="Dni" class="form-control" maxlength="8" inputmode="numeric" />
                        <span asp-validation-for="Dni" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Descripcion" class="form-label"></label>
                        <input asp-for="Descripcion" class="form-control" />
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Pagar</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
