@model IReadOnlyList<demomvcdata.Integrations.NoticiaItem>

@{
    ViewData["Title"] = "Noticias";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="mb-1">Noticias sobre inseguridad en Peru</h1>
        <p class="text-muted mb-0">Fuente: NewsData.io</p>
    </div>
    <span class="badge text-bg-secondary">@Model.Count noticia(s)</span>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No se encontraron noticias en este momento o falta configurar la API key de NewsData.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var noticia in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    @if (!string.IsNullOrWhiteSpace(noticia.ImageUrl))
                    {
                        <img src="@noticia.ImageUrl" class="card-img-top" alt="@noticia.Title" style="height: 200px; object-fit: cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="mb-2 text-muted small">
                            @(string.IsNullOrWhiteSpace(noticia.SourceId) ? "Fuente no disponible" : noticia.SourceId)
                            @if (!string.IsNullOrWhiteSpace(noticia.PublishedAt))
                            {
                                <span> | @noticia.PublishedAt</span>
                            }
                        </div>
                        <h5 class="card-title">@noticia.Title</h5>
                        <p class="card-text flex-grow-1">@(string.IsNullOrWhiteSpace(noticia.Description) ? "Sin descripción disponible." : noticia.Description)</p>
                        <a href="@noticia.Link" target="_blank" rel="noopener noreferrer" class="btn btn-outline-primary mt-3">Ver noticia</a>
                    </div>
                </div>
            </div>
        }
    </div>
}